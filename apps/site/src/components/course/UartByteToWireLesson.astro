<section class="lesson surface" aria-labelledby="uart-u01-title" data-uart-lesson>
  <header>
    <p class="eyebrow">互动练习 · uart-u01-byte-to-wire</p>
    <h2 id="uart-u01-title">把一个字符变成 8N1 帧</h2>
    <p>先预测最低有效位，再查看 UART 实际发送顺序。练习只接受单个 ASCII 字符。</p>
  </header>

  <form class="exercise" data-frame-form>
    <div class="field">
      <label for="uart-character">选择一个字符</label>
      <input id="uart-character" name="character" value="A" maxlength="1" autocomplete="off" inputmode="text" />
    </div>
    <fieldset>
      <legend>不计算：你认为第一个数据位 D0 是多少？</legend>
      <label><input type="radio" name="prediction" value="0" required /> 0</label>
      <label><input type="radio" name="prediction" value="1" /> 1</label>
    </fieldset>
    <button class="button primary" type="submit">检查并生成帧</button>
  </form>

  <p class="feedback" data-feedback role="status" aria-live="polite">先选择你的预测，再生成帧。</p>

  <div class="result" data-result hidden>
    <dl class="conversion">
      <div><dt>字符</dt><dd data-character>A</dd></div>
      <div><dt>ASCII</dt><dd data-hex>0x41</dd></div>
      <div><dt>二进制</dt><dd data-binary>0100 0001</dd></div>
      <div><dt>数据位发送顺序</dt><dd data-wire-order>1 0 0 0 0 0 1 0</dd></div>
    </dl>
    <div class="frame" data-frame aria-label="UART 8N1 帧"></div>
    <p class="hint">从左到右是时间方向。起始位固定为 0，8 个数据位按最低有效位优先发送，停止位固定为 1。</p>
  </div>

  <form class="check" data-start-form>
    <fieldset>
      <legend>接收端通常把空闲高电平后的哪种变化视为一帧可能开始？</legend>
      <label><input type="radio" name="edge" value="rise" required /> 从低到高</label>
      <label><input type="radio" name="edge" value="fall" /> 从高到低</label>
      <label><input type="radio" name="edge" value="none" /> 保持高电平</label>
    </fieldset>
    <button class="button" type="submit">检查答案</button>
    <p data-start-feedback role="status" aria-live="polite"></p>
  </form>

  <aside class="real-check">
    <strong>把模型带到真实设备</strong>
    <p>后续接上逻辑分析仪时，先寻找空闲高电平，再寻找起始位的下降沿。若波形与这里相反，先检查电平标准或信号是否经过反相。</p>
  </aside>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-uart-lesson]');
  if (root) {
    const frameForm = root.querySelector<HTMLFormElement>('[data-frame-form]')!;
    const input = root.querySelector<HTMLInputElement>('#uart-character')!;
    const feedback = root.querySelector<HTMLElement>('[data-feedback]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;

    frameForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const character = Array.from(input.value)[0] ?? '';
      const code = character.codePointAt(0);
      const prediction = new FormData(frameForm).get('prediction');
      if (code === undefined || code > 0x7f) {
        feedback.textContent = '请输入一个 ASCII 字符（编码范围 0x00–0x7F）。';
        feedback.dataset.state = 'error';
        result.hidden = true;
        return;
      }
      const binary = code.toString(2).padStart(8, '0');
      const dataBits = [...binary].reverse();
      const correct = prediction === dataBits[0];
      feedback.textContent = correct
        ? `预测正确：D0 是最低有效位 ${dataBits[0]}。`
        : `这次 D0 是 ${dataBits[0]}。UART 先发送最低有效位，所以要从二进制最右侧开始读。`;
      feedback.dataset.state = correct ? 'correct' : 'retry';
      root.querySelector<HTMLElement>('[data-character]')!.textContent = character;
      root.querySelector<HTMLElement>('[data-hex]')!.textContent = `0x${code.toString(16).toUpperCase().padStart(2, '0')}`;
      root.querySelector<HTMLElement>('[data-binary]')!.textContent = `${binary.slice(0, 4)} ${binary.slice(4)}`;
      root.querySelector<HTMLElement>('[data-wire-order]')!.textContent = dataBits.join(' ');
      const bits = [{ label: 'Start', value: '0' }, ...dataBits.map((value, index) => ({ label: `D${index}`, value })), { label: 'Stop', value: '1' }];
      frame.replaceChildren(...bits.map(({label, value}) => {
        const cell = document.createElement('span');
        cell.className = 'bit';
        cell.dataset.level = value;
        cell.innerHTML = `<b>${value}</b><small>${label}</small>`;
        return cell;
      }));
      frame.setAttribute('aria-label', `8N1 帧：${bits.map(({label,value})=>`${label} ${value}`).join('，')}`);
      result.hidden = false;
    });

    const startForm = root.querySelector<HTMLFormElement>('[data-start-form]')!;
    startForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const answer = new FormData(startForm).get('edge');
      const output = root.querySelector<HTMLElement>('[data-start-feedback]')!;
      output.textContent = answer === 'fall'
        ? '正确。空闲为高电平，起始位为低电平，因此高到低的变化提示接收端开始计时。'
        : '再想一下：空闲状态是高电平，而起始位固定为低电平。';
      output.dataset.state = answer === 'fall' ? 'correct' : 'retry';
    });
  }
</script>

<style>
  .lesson{max-width:60rem;margin:3rem 0;padding:clamp(1rem,3vw,2rem)}.lesson header h2{margin:.35rem 0}.lesson header p:last-child{color:var(--color-text-muted)}.exercise,.check{display:grid;gap:1rem;margin-top:1.5rem}.field{display:grid;gap:.35rem;max-width:16rem}.field label,legend{font-weight:700}.field input{min-height:44px;padding:.5rem .75rem;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);background:var(--color-bg);color:var(--color-text)}fieldset{display:flex;flex-wrap:wrap;gap:.75rem 1.25rem;margin:0;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-md)}fieldset label{display:flex;align-items:center;gap:.4rem}.exercise .button,.check .button{justify-self:start}.feedback,[data-start-feedback]{min-height:1.75rem;font-weight:600}.feedback[data-state='correct'],[data-start-feedback][data-state='correct']{color:var(--color-verified)}.feedback[data-state='error']{color:var(--color-danger)}.feedback[data-state='retry'],[data-start-feedback][data-state='retry']{color:var(--color-warning)}.conversion{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem}.conversion div{padding:.75rem;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-bg)}.conversion dt{color:var(--color-text-muted);font-size:.75rem}.conversion dd{margin:0;font:600 .95rem/1.6 var(--font-mono)}.frame{display:grid;grid-template-columns:repeat(10,minmax(3.25rem,1fr));gap:.25rem;overflow-x:auto;margin-top:1rem;padding-bottom:.5rem}.bit{position:relative;min-height:6rem;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:.65rem .25rem;border:1px solid var(--color-border-strong);border-top:4px solid var(--color-primary);border-radius:var(--radius-sm);background:var(--color-surface-subtle)}.bit[data-level='0']{justify-content:flex-end;border-top-color:var(--color-border-strong);border-bottom:4px solid var(--color-primary)}.bit b{font:700 1.25rem/1 var(--font-mono)}.bit small{color:var(--color-text-muted)}.hint{color:var(--color-text-muted);font-size:.875rem}.real-check{margin-top:2rem;padding:1rem;border-left:3px solid var(--color-verified);background:var(--color-surface-subtle)}.real-check p{margin:.25rem 0}.result[hidden]{display:none}@media(max-width:48rem){.conversion{grid-template-columns:repeat(2,1fr)}}
</style>
