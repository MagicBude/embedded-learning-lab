---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import UartByteToWireLesson from '@/components/course/UartByteToWireLesson.astro';
import UartTimingLesson from '@/components/course/UartTimingLesson.astro';
import { withBase } from '@/lib/site';
export async function getStaticPaths(){const entries=await getCollection('course');return entries.map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));}
const { entry } = Astro.props;
const { Content } = await render(entry);
const publicKnowledge = (await getCollection('knowledge')).filter(({data})=>data.maturity==='verified'&&data.visibility==='public');
const knowledgeById = new Map(publicKnowledge.map((item)=>[item.data.id,item.data]));
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><div class="container page"><p class="crumb"><a href={withBase('/courses/')}>课程</a> / {entry.data.title}</p><header class="reading"><p class="eyebrow">Course · v{entry.data.version}</p><h1>{entry.data.title}</h1><p class="summary">{entry.data.summary}</p><div class="meta"><span class="tag">{entry.data.maturity === 'verified' ? '可学习' : '审核中'}</span><span class="muted">{entry.data.units.filter((unit)=>unit.status==='available').length} / {entry.data.units.length} 单元可用</span></div></header><section class="reading notice"><strong>发布状态</strong><p>这是课程审核预览，前两个单元可学习，但整门课程尚未完成。课程会在正文中讲清当前单元的必要概念；关联 Knowledge 用于复习和查阅来源。</p></section><nav class="course-map surface" aria-label="课程单元"><strong>课程地图</strong><ol>{entry.data.units.map((unit,index)=><li><span>{String(index+1).padStart(2,'0')}</span><span>{unit.title}</span><span class="tag">{unit.status==='available'?'可学习':unit.status==='in-progress'?'建设中':'已规划'}</span></li>)}</ol></nav><article class="prose course-intro"><Content components={{UartByteToWireLesson,UartTimingLesson}} /></article><section><h2>关联 Knowledge</h2><p class="muted">用于复习稳定事实和追溯来源，不替代课程中的必要讲解。</p><ol class="units">{entry.data.units.map((unit,index)=><li class="surface"><span class="number">{String(index+1).padStart(2,'0')}</span><div><h3>{unit.title}</h3><p>{unit.objective}</p><div class="links">{unit.knowledge.map((id)=>{const item=knowledgeById.get(id);return item&&<a href={withBase(`/knowledge/${item.slug}/`)}>{item.title}</a>})}</div></div><span class="tag">{unit.status==='available'?'可学习':unit.status==='in-progress'?'建设中':'已规划'}</span></li>)}</ol></section></div></BaseLayout>
<style>.page{padding-block:2rem}.crumb{font-size:.875rem;color:var(--color-text-muted)}header h1{margin:.5rem 0}.summary{font-size:1.125rem;color:var(--color-text-muted)}.meta,.links{display:flex;flex-wrap:wrap;gap:.5rem}.meta{margin:1rem 0 2rem}.notice{padding:1rem;border-left:3px solid var(--color-warning);background:var(--color-surface-subtle)}.notice p{margin:.25rem 0}.course-map{max-width:60rem;margin:1.5rem 0;padding:1rem 1.25rem}.course-map ol{display:grid;gap:.5rem;margin:.75rem 0 0;padding:0;list-style:none}.course-map li{display:grid;grid-template-columns:2.5rem minmax(0,1fr) auto;align-items:center;gap:.5rem}.course-map li>span:first-child{font:600 .8rem/1.5 var(--font-mono);color:var(--color-primary)}.course-intro{width:min(100%,60rem);margin-top:2rem}.course-intro :global(hr){margin:4rem 0;border:0;border-top:1px solid var(--color-border)}.course-intro :global(h2){scroll-margin-top:5rem}.course-intro :global(h3){margin-top:2rem}.units{display:grid;gap:.75rem;padding:0;list-style:none}.units li{display:grid;grid-template-columns:3rem 1fr auto;gap:1rem;padding:1rem}.number{font:600 1rem/1.5 var(--font-mono);color:var(--color-primary)}.units h3,.units p{margin:.1rem 0}.units p{color:var(--color-text-muted)}.links{margin-top:.6rem;font-size:.875rem}@media(max-width:40rem){.course-map li{grid-template-columns:2rem minmax(0,1fr)}.course-map li>.tag{grid-column:2;justify-self:start}.units li{grid-template-columns:2rem 1fr}.units li>.tag{grid-column:2;justify-self:start}}</style>
