---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
export async function getStaticPaths(){const entries=await getCollection('course');return entries.map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));}
const { entry } = Astro.props;
const publicKnowledge = (await getCollection('knowledge')).filter(({data})=>data.maturity==='verified'&&data.visibility==='public');
const knowledgeById = new Map(publicKnowledge.map((item)=>[item.data.id,item.data]));
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><div class="container page"><p class="crumb"><a href={withBase('/courses/')}>课程</a> / {entry.data.title}</p><header class="reading"><p class="eyebrow">Course · v{entry.data.version}</p><h1>{entry.data.title}</h1><p class="summary">{entry.data.summary}</p><div class="meta"><span class="tag">{entry.data.maturity === 'verified' ? '可学习' : '审核中'}</span><span class="muted">{entry.data.units.filter((unit)=>unit.status==='available').length} / {entry.data.units.length} 单元可用</span></div></header><section class="reading notice"><strong>发布状态</strong><p>这是课程结构预览，不代表课程已经完成。已验证的稳定知识可通过下方 Knowledge 链先行学习。</p></section><section><h2>学习单元</h2><ol class="units">{entry.data.units.map((unit,index)=><li class="surface"><span class="number">{String(index+1).padStart(2,'0')}</span><div><h3>{unit.title}</h3><p>{unit.objective}</p><div class="links">{unit.knowledge.map((id)=>{const item=knowledgeById.get(id);return item&&<a href={withBase(`/knowledge/${item.slug}/`)}>{item.title}</a>})}</div></div><span class="tag">{unit.status==='available'?'可学习':unit.status==='in-progress'?'建设中':'已规划'}</span></li>)}</ol></section></div></BaseLayout>
<style>.page{padding-block:2rem}.crumb{font-size:.875rem;color:var(--color-text-muted)}header h1{margin:.5rem 0}.summary{font-size:1.125rem;color:var(--color-text-muted)}.meta,.links{display:flex;flex-wrap:wrap;gap:.5rem}.meta{margin:1rem 0 2rem}.notice{padding:1rem;border-left:3px solid var(--color-warning);background:var(--color-surface-subtle)}.notice p{margin:.25rem 0}.units{display:grid;gap:.75rem;padding:0;list-style:none}.units li{display:grid;grid-template-columns:3rem 1fr auto;gap:1rem;padding:1rem}.number{font:600 1rem/1.5 var(--font-mono);color:var(--color-primary)}.units h3,.units p{margin:.1rem 0}.units p{color:var(--color-text-muted)}.links{margin-top:.6rem;font-size:.875rem}@media(max-width:40rem){.units li{grid-template-columns:2rem 1fr}.units li>.tag{grid-column:2;justify-self:start}}</style>
