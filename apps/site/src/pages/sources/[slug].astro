---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';

export async function getStaticPaths() {
  const entries = (await getCollection('sources')).filter(({ data }) => data.maturity === 'verified' && data.visibility === 'public');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const guides = (await getCollection('knowledge'))
  .filter(({ data }) => data.maturity === 'verified' && data.visibility === 'public')
  .filter(({ data }) => data.sources.some((citation) => citation.sourceId === entry.data.id));

const authorityLabels = { normative: '规范性来源', official: '官方资料', educational: '系统教程', practitioner: '工程实践', community: '社区资料' };
const accessLabels = { free: '免费访问', registration: '需注册', mixed: '免费与付费混合', paid: '付费' };
const sourceTypeLabels = { standard: '标准与规范', 'official-doc': '官方文档', 'official-code': '官方源码', book: '书籍', paper: '论文', course: '课程', article: '文章', video: '视频', community: '社区资料' };
const platformLabels: Record<string, string> = { generic: '通用' };
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="container page">
    <p class="crumb"><a href={withBase('/sources/')}>资料库</a> / {entry.data.title}</p>
    <header class="reading">
      <p class="eyebrow">{authorityLabels[entry.data.authorityLevel]} · {sourceTypeLabels[entry.data.sourceType]}</p>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      <div class="meta"><span class="tag verified">✓ 身份已核对</span><span class="tag">{accessLabels[entry.data.access]}</span>{entry.data.platforms.map((platform) => <span class="tag">{platformLabels[platform] ?? platform}</span>)}</div>
      <a class="button primary" href={entry.data.url} rel="external">打开原始资料 ↗</a>
    </header>

    <div class="article-grid">
      <aside class="surface facts">
        <dl>
          <div><dt>维护者</dt><dd>{entry.data.organization ?? entry.data.authors.join('、')}</dd></div>
          {entry.data.version && <div><dt>版本</dt><dd>{entry.data.version}</dd></div>}
          <div><dt>最后核对</dt><dd>{entry.data.checkedAt.toLocaleDateString('zh-CN')}</dd></div>
          <div><dt>许可证</dt><dd>{entry.data.license}</dd></div>
          <div><dt>本地副本</dt><dd>{entry.data.localCopy ? '允许并已明确记录' : '不保存，只链接原始入口'}</dd></div>
        </dl>
      </aside>

      <article class="prose reading" data-pagefind-body>
        <section class="notice"><strong>复用边界</strong><p>{entry.data.reuse}</p></section>
        <Content />
        <section><h2>推荐阅读位置</h2><ul>{entry.data.readingGuide.map((item) => <li>{item}</li>)}</ul></section>
        <section><h2>适用范围</h2><ul>{entry.data.scope.map((item) => <li>{item}</li>)}</ul></section>
        <section><h2>优势与限制</h2><h3>优势</h3><ul>{entry.data.strengths.map((item) => <li>{item}</li>)}</ul><h3>限制</h3><ul>{entry.data.limitations.map((item) => <li>{item}</li>)}</ul></section>
        {guides.length > 0 && <section class="related"><h2>使用这份资料的主题指南</h2><div>{guides.map(({ data }) => <a class="surface" href={withBase(`/knowledge/${data.slug}/`)}><strong>{data.title}</strong><span>{data.summary}</span></a>)}</div></section>}
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .page{padding-block:2rem}.crumb{font-size:.875rem;color:var(--color-text-muted)}header h1{margin:.5rem 0}.summary{font-size:1.125rem;color:var(--color-text-muted)}.meta{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.25rem 0}.article-grid{display:grid;grid-template-columns:17rem minmax(0,1fr);gap:3rem;align-items:start;margin-top:2rem}.facts{padding:1rem}.facts dl{margin:0}.facts div+div{margin-top:.8rem;padding-top:.8rem;border-top:1px solid var(--color-border)}.facts dt{color:var(--color-text-muted);font-size:.75rem;font-weight:700}.facts dd{margin:.15rem 0 0;overflow-wrap:anywhere}.notice{padding:1rem;border-left:3px solid var(--color-warning);background:var(--color-surface-subtle)}.notice p{margin:.25rem 0}.related{margin-top:3rem;padding-top:1rem;border-top:1px solid var(--color-border)}.related>div{display:grid;gap:.75rem}.related a{display:grid;padding:1rem;color:inherit;text-decoration:none}.related a:hover strong{color:var(--color-primary)}.related span{color:var(--color-text-muted)}
  @media(max-width:64rem){.article-grid{grid-template-columns:1fr}.facts{width:min(100%,var(--content-reading))}}
</style>
