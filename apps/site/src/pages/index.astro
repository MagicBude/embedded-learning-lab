---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
const knowledge = (await getCollection('knowledge')).filter(({ data }) => data.maturity === 'verified' && data.visibility === 'public');
---
<BaseLayout>
  <div class="container hero"><div><p class="eyebrow">Read · Experiment · Build</p><h1>把嵌入式知识，变成可验证的工程能力。</h1><p class="lead">从 C 语言、单片机与通信协议，到 RTOS、Embedded Linux 和系统设计。沿路线学习，在实验中验证。</p><div class="actions"><a class="button primary" href={withBase('/paths/')}>从学习路线开始</a><a class="button" href={withBase('/knowledge/')}>浏览 Knowledge</a></div></div><aside>第一条纵向切片以 STM32F103C8T6 和 UART 为实践入口，从通用原理逐步连接到真实硬件验证。</aside></div>
  <section class="container section"><div class="section-heading"><h2>学习路线</h2><a href={withBase('/paths/')}>查看完整路线 →</a></div><div class="route-grid"><div class="route trunk"><strong>公共主干</strong><span>C · 数电 · MCU · 调试 · 通信</span></div>{['MCU / RTOS','Linux 应用','BSP / 驱动','网络 / IoT'].map((name)=><div class="route"><strong>{name}</strong><span>已规划，随真实内容逐步开放</span></div>)}</div></section>
  <section class="container section"><div class="section-heading"><h2>已验证内容</h2><a href={withBase('/knowledge/')}>浏览全部 →</a></div>{knowledge.length > 0 ? <div class="content-list">{knowledge.map(({ data })=><a class="content-row" href={withBase(`/knowledge/${data.slug}/`)}><span class="eyebrow">Knowledge</span><div><h3>{data.title}</h3><p>{data.summary}</p></div><span class="tag verified">✓ 已验证</span></a>)}</div> : <div class="surface empty"><h3>内容正在接受技术验证</h3><p>只有达到发布条件的内容才会出现在这里。</p></div>}</section>
</BaseLayout>
<style>.hero{padding-block:clamp(3rem,8vw,6rem);display:grid;grid-template-columns:minmax(0,1.5fr) minmax(16rem,.5fr);gap:4rem;align-items:end}.hero h1{max-width:14ch;margin:.75rem 0 1rem}.lead{max-width:42rem;color:var(--color-text-muted);font-size:1.125rem}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.75rem}.hero aside{padding-left:1.25rem;border-left:3px solid var(--color-verified);color:var(--color-text-muted)}.route-grid{display:grid;grid-template-columns:1.1fr repeat(4,1fr);gap:.75rem}.route{min-height:7rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface)}.route.trunk{background:var(--color-surface-subtle)}.route strong,.route span{display:block}.route span{margin-top:.5rem;color:var(--color-text-muted);font-size:.875rem}.empty{padding:1.5rem}.empty h3,.empty p{margin:.2rem 0}@media(max-width:64rem){.route-grid{grid-template-columns:repeat(2,1fr)}.route.trunk{grid-column:1/-1}}@media(max-width:48rem){.hero{grid-template-columns:1fr;gap:2rem}.route-grid{grid-template-columns:1fr}.route.trunk{grid-column:auto}}</style>
