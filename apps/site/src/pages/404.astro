---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
---
<BaseLayout title="页面不存在"><div class="container reading page"><p class="eyebrow">404</p><h1>这里还没有可用内容</h1><p class="muted">链接可能已经调整，或者这个规划节点尚未形成真实内容。</p><a class="button primary" href={withBase('/')}>返回首页</a></div></BaseLayout><style>.page{padding-block:5rem}.page .button{margin-top:1rem}</style>
