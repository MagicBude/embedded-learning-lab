---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
export async function getStaticPaths(){const entries=(await getCollection('knowledge')).filter(({data})=>data.maturity==='verified'&&data.visibility==='public');return entries.map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const published = (await getCollection('knowledge')).filter(({data})=>data.maturity==='verified'&&data.visibility==='public');
const byId = new Map(published.map((item)=>[item.data.id,item.data]));
const prerequisites = entry.data.prerequisites.map((id:string)=>byId.get(id)).filter(Boolean);
const related = entry.data.related.map((id:string)=>byId.get(id)).filter(Boolean);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><div class="container page"><p class="crumb"><a href={withBase('/knowledge/')}>Knowledge</a> / {entry.data.title}</p><header class="reading"><p class="eyebrow">{entry.data.domain}</p><h1>{entry.data.title}</h1><p class="summary">{entry.data.summary}</p><div class="meta"><span class="tag verified">✓ {entry.data.maturity}</span>{entry.data.platforms.map((platform:string)=><span class="tag">{platform}</span>)}<span class="muted">验证于 {entry.data.verifiedAt?.toLocaleDateString('zh-CN')}</span></div>{prerequisites.length>0&&<div class="learning-order"><strong>建议先读</strong>{prerequisites.map((item:any)=><a href={withBase(`/knowledge/${item.slug}/`)}>{item.title}</a>)}</div>}</header><div class="article-grid">{headings.length>0&&<aside><strong>本文目录</strong><ul>{headings.filter((h)=>h.depth<=3).map((h)=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside>}<article class="prose reading" data-pagefind-body><Content/>{related.length>0&&<section class="related"><h2>继续学习</h2><div>{related.map((item:any)=><a class="surface" href={withBase(`/knowledge/${item.slug}/`)}><strong>{item.title}</strong><span>{item.summary}</span></a>)}</div></section>}<section class="sources"><h2>来源与验证依据</h2><ol>{entry.data.sources.map((source)=><li id={source.id}><a href={source.url}>{source.title}</a>{source.locator&&` · ${source.locator}`}<br/><span class="muted">支持：{source.supports.join('；')}</span></li>)}</ol></section></article></div></div></BaseLayout>
<style>.page{padding-block:2rem}.crumb{font-size:.875rem;color:var(--color-text-muted)}header h1{margin:.5rem 0}.summary{font-size:1.125rem;color:var(--color-text-muted)}.meta,.learning-order{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem}.meta{margin:1.25rem 0}.learning-order{margin-bottom:2rem;padding:.75rem 1rem;border-left:3px solid var(--color-primary);background:var(--color-surface-subtle)}.article-grid{display:grid;grid-template-columns:12rem minmax(0,1fr);gap:3rem;align-items:start}.article-grid aside{position:sticky;top:1rem;font-size:.875rem}.article-grid aside ul{padding-left:1.1rem}.article-grid aside a{color:var(--color-text-muted)}.related,.sources{margin-top:3rem;padding-top:1rem;border-top:1px solid var(--color-border)}.related>div{display:grid;gap:.75rem}.related a{display:grid;padding:1rem;color:inherit;text-decoration:none}.related a:hover strong{color:var(--color-primary)}.related span{color:var(--color-text-muted)}@media(max-width:64rem){.article-grid{grid-template-columns:1fr}.article-grid aside{position:static;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface)}}</style>
