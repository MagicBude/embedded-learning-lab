---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
const entries = (await getCollection('knowledge')).filter(({ data }) => data.maturity === 'verified' && data.visibility === 'public').sort((a,b)=>b.data.updatedAt.valueOf()-a.data.updatedAt.valueOf());
---
<BaseLayout title="主题指南" description="连接可靠资料、项目解释与实验依据的嵌入式主题指南。"><div class="container page"><p class="eyebrow">Guides</p><h1>主题指南</h1><p class="intro">主题指南负责比较和连接资料，不替代标准、官方手册或原作者内容。关键结论应能回到资料卡、具体引用或实验。</p><div class="content-list">{entries.map(({ data })=><a class="content-row" href={withBase(`/knowledge/${data.slug}/`)}><span class="eyebrow">{data.domain}</span><div><h3>{data.title}</h3><p>{data.summary}</p></div><span class="tag verified">✓ 有出处</span></a>)}</div></div></BaseLayout>
<style>.page{padding-block:3rem}.page h1{margin:.5rem 0}.intro{max-width:44rem;margin-bottom:2.5rem;color:var(--color-text-muted)}</style>
